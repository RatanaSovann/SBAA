.venv/
__pycache__/
*.pyc
data/uploads/
data/cache/
# Analyst working state. Unlike the two above this is NOT regenerable -- see CLAUDE.md.
data/progress/
# Analyst-added placement categories. Cheap to retype, but losing it silently reverts
# auto-discovery to mislabelling placements it no longer has a bucket for.
data/categories.json
*.egg-info/
streamlit.log
streamlit_run.log
nimbalyst-local/
.env

# Large local test assets — never commit match footage or video in general.
sample_data/video/
*.mp4
*.mov
*.mkv
*.avi

# Model checkpoints downloaded on demand (ultralytics/YOLOE etc.) -- never commit weights.
*.pt
mobileclip2_b.ts

# Locally-installed agent skills (via `npx skills add`) -- personal tooling, unrelated to SBAA.
.agents/
.claude/
skills-lock.json
.nimbalyst/

# Office lock files, created while a doc is open in Word.
~$*

# The walkthrough document and its assets: ~11MB of broadcast stills, a GIF and a .docx.
# Deliberately local-only -- not committed, and not published anywhere. Rebuild it with
# docs/build.py; see docs/README.md.
docs/
